# LLM textual (produção) e visão de boletos (preview)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Telegram. PUBLIC_BASE_URL deve ser HTTPS público (ex.: túnel da demo).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_BASE_URL=https://seu-endereco-publico.example
APP_PUBLIC_URL=https://seu-app-web.example
TELEGRAM_ALLOW_DEMO_USER=true
TELEGRAM_DEMO_USER_ID=demo

# Opcional
DATABASE_URL=sqlite+aiosqlite:///./apf.db
AUTO_SEED_DEMO=false
